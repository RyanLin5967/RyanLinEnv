FROM python:3.12.13-slim
# CPU is the portable default. On a Linux NVIDIA host, pass the matching official
# CUDA wheel index as TORCH_INDEX_URL and generate a task with device="cuda".
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 \
    RF_HOME=/opt/rfdetr-cache HF_HOME=/opt/hf-cache
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 \
    --index-url "${TORCH_INDEX_URL}"
COPY requirements-detection.lock /opt/requirements-detection.lock
# All common runtime and build dependencies have exact versions and hashes.
# --no-deps preserves the explicit backend above; the lock includes torch's
# shared dependencies but never substitutes PyPI's CUDA torch for CPU torch.
RUN pip install --no-cache-dir --no-deps --require-hashes \
    -r /opt/requirements-detection.lock && pip check
# This is the published public initialization, never a submitted checkpoint.
# Cache it while network is available; all Harbor training and grading is offline.
RUN python -c "from rfdetr import RFDETRNano; RFDETRNano(device='cpu', num_classes=1, amp=False)"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY pyproject.toml /opt/vision-rl/pyproject.toml
COPY src /opt/vision-rl/src
RUN pip install --no-cache-dir --no-deps --no-build-isolation /opt/vision-rl \
    && pip check \
    && python -c "from rfdetr import RFDETRNano; RFDETRNano(pretrain_weights=None, device='cpu', num_classes=1, amp=False)"
CMD ["python", "-m", "vision_rl.detection_training", "--help"]
